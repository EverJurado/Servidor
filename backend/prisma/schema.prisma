generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id_usuario       Int      @id @default(autoincrement())
  rol              String?
  nombre           String?
  apellidopaterno  String?
  apellidomaterno  String?
  email            String?  @unique
  contrasena       String?
  foto             String?
  telefono         Int?
  pais             String?
  ciudad           String?
  genero           String?
  fechacreacion    DateTime @default(now())
  verificado       Boolean?
  reset_token      String?

  agenda           agenda[]
}

model eventos {
  id_evento         Int                    @id @default(autoincrement())
  titulo            String?
  descripcion       String?
  foto_evento       String?
  hora_inicio       String?
  hora_fin          String?
  fecha             DateTime?
  costo             String?
  modalidad         String?
  ubicacion         String?
  link_reunion      String?
  reunion_iniciada  Boolean?

  agenda            agenda[]
  expositores       eventos_expositores[]
  patrocinadores    eventos_patrocinadores[]
}

model expositores {
  id_expositor  Int                 @id @default(autoincrement())
  nombre        String?
  especialidad  String?
  institucion   String?
  contacto      String?

  eventos       eventos_expositores[]
}

model eventos_expositores {
  id_evento     Int
  id_expositor  Int

  evento        eventos     @relation(fields: [id_evento], references: [id_evento])
  expositor     expositores @relation(fields: [id_expositor], references: [id_expositor])

  @@id([id_evento, id_expositor])
}

model patrocinadores {
  id_patrocinador  Int                 @id @default(autoincrement())
  razon_social     String?
  institucion      String?

  eventos          eventos_patrocinadores[]
}

model eventos_patrocinadores {
  id_evento        Int
  id_patrocinador  Int

  evento           eventos        @relation(fields: [id_evento], references: [id_evento])
  patrocinador     patrocinadores @relation(fields: [id_patrocinador], references: [id_patrocinador])

  @@id([id_evento, id_patrocinador])
}

model agenda {
  id_agenda    Int       @id @default(autoincrement())
  id_usuario   Int
  id_evento    Int
  actividad    String?
  fecha        DateTime?
  comentario   String?
  calificacion Int?
  asistio      Boolean?
  hora_ingreso DateTime?

  usuario      usuarios   @relation(fields: [id_usuario], references: [id_usuario])
  evento       eventos    @relation(fields: [id_evento], references: [id_evento])
}
